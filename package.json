{
  "name": "@amadeus/qq",
  "version": "0.1.0",
  "private": true,
  "description": "Amadeus QQ continuous interaction plugin for DeepSeek Harness",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./preset-guard": "./src/preset-guard.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "src/*.mjs",
    "src/client",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "preset.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.18.3"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
